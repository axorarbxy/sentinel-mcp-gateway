{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "gateway": {
      "root": "./",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "daemons": {
    "event-worker": {
      "root": "./",
      "entrypoint": "Dockerfile.worker",
      "instances": { "bom1": 1 }
    }
  },
  "rewrites": [
    { "source": "/auth/(.*)", "destination": { "service": "gateway" } },
    { "source": "/mcp/(.*)", "destination": { "service": "gateway" } },
    { "source": "/cybereye/(.*)", "destination": { "service": "gateway" } },
    { "source": "/api/(.*)", "destination": { "service": "gateway" } },
    { "source": "/ml/(.*)", "destination": { "service": "gateway" } },
    { "source": "/logs/(.*)", "destination": { "service": "gateway" } },
    { "source": "/logs", "destination": { "service": "gateway" } },
    { "source": "/stats", "destination": { "service": "gateway" } },
    { "source": "/metrics", "destination": { "service": "gateway" } },
    { "source": "/agent/(.*)", "destination": { "service": "gateway" } },
    { "source": "/agents/(.*)", "destination": { "service": "gateway" } },
    { "source": "/health", "destination": { "service": "gateway" } },
    { "source": "/openapi.json", "destination": { "service": "gateway" } },
    { "source": "/docs(.*)", "destination": { "service": "gateway" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
