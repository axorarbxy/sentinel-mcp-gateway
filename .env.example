DATABASE_URL=sqlite:///./database/sentinel_mcp.db
SENTINEL_REDIS_URL=redis://127.0.0.1:6379/0
SENTINEL_EVENT_STREAM_MAXLEN=100000
SENTINEL_EVENT_CONSUMER_GROUP=sentinel-live-dashboard-v1
SENTINEL_EVENT_TRANSPORTS=redis
SENTINEL_EVENT_TOPIC=gateway.events
SENTINEL_EVENT_PRODUCER_ID=sentinel-gateway
# Optional broker-blind event protection. Use base64-encoded 32-byte keys.
# Publishers need ENCRYPTION_KEY + SIGNING_PRIVATE_KEY; subscribers need
# ENCRYPTION_KEY + SIGNING_PUBLIC_KEY. Keep private keys out of subscriber hosts.
SENTINEL_EVENT_ENCRYPTION_KEY=
SENTINEL_EVENT_SIGNING_PRIVATE_KEY=
SENTINEL_EVENT_SIGNING_PUBLIC_KEY=
SENTINEL_WS_MAX_CONNECTIONS=200
SENTINEL_WS_CONTROL_RATE=60
SENTINEL_WS_MAX_CONTROL_BYTES=4096
SENTINEL_WS_TICKET_RATE=20
SENTINEL_OUTBOX_MAX_ATTEMPTS=12
SENTINEL_CEP_AGENT_BLOCK_THRESHOLD=5
SENTINEL_CEP_AGENT_BLOCK_WINDOW_SECONDS=120
SENTINEL_CEP_RULE_AGENT_THRESHOLD=3
SENTINEL_CEP_RULE_AGENT_WINDOW_SECONDS=300
SENTINEL_CEP_FANOUT_AGENT_THRESHOLD=3
SENTINEL_CEP_FANOUT_WINDOW_SECONDS=300
SENTINEL_EVENT_REPLAY_RETENTION_SECONDS=86400
SENTINEL_MQTT_URL=
SENTINEL_MQTT_USERNAME=
SENTINEL_MQTT_PASSWORD=
SENTINEL_MQTT_TOPIC=sentinel/mcp/events
SENTINEL_MQTT_TLS_CAFILE=
SENTINEL_KAFKA_BOOTSTRAP_SERVERS=
SENTINEL_KAFKA_TOPIC=sentinel-mcp-events
SENTINEL_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SENTINEL_KAFKA_SASL_MECHANISM=PLAIN
SENTINEL_KAFKA_USERNAME=
SENTINEL_KAFKA_PASSWORD=
SENTINEL_KAFKA_SSL_CAFILE=
SECRET_KEY=replace-with-a-long-random-secret
SENTINEL_ENVIRONMENT=dev
SENTINEL_ALLOWED_HOSTS=localhost,127.0.0.1
SENTINEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
SENTINEL_RATE_LIMIT_REQUESTS=60
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=60
SENTINEL_AGENT_RATE_LIMIT_REQUESTS=60
SENTINEL_AUTH_FAILURE_LIMIT=10
SENTINEL_AUTH_FAILURE_WINDOW_SECONDS=60
SENTINEL_FORCE_HTTPS=false
SENTINEL_MCP_UPSTREAM_URL=http://127.0.0.1:9000/mcp
SENTINEL_MCP_UPSTREAM_NAME=local-mcp
SENTINEL_MCP_UPSTREAM_TOKEN=
SENTINEL_MCP_UPSTREAM_TIMEOUT_SECONDS=30
SENTINEL_MCP_UNKNOWN_METHOD_MODE=strict
SENTINEL_MCP_REDACTION_PATTERNS=[]

# Standalone CyberEye workspace MCP service (backend/cybereye_mcp_server.py)
CYBEREYE_ENVIRONMENT=development
CYBEREYE_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CYBEREYE_JWT_ISSUER=cybereye-mcp-gateway
CYBEREYE_JWT_AUDIENCE=cybereye-operator
CYBEREYE_TOKEN_TTL_SECONDS=900
CYBEREYE_WORKSPACE_ROOT=./workspace
CYBEREYE_APPROVAL_DB=./data/cybereye-approvals.sqlite3
CYBEREYE_APPROVAL_TTL_SECONDS=1800
CYBEREYE_RATE_LIMIT_REQUESTS=120
CYBEREYE_RATE_LIMIT_WINDOW_SECONDS=60
CYBEREYE_DEMO_AUTH=false
CYBEREYE_PORT=9001
