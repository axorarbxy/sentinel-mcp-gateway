FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libzbar0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-vercel.txt ./requirements-vercel.txt
RUN pip install --no-cache-dir -r requirements-vercel.txt

# Keep the daemon image CPU-only as well; the gateway imports the scanner module.
RUN pip install --no-cache-dir torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu

COPY . .
CMD ["python", "-m", "backend.worker"]
