FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libzbar0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-vercel.txt ./requirements-vercel.txt
RUN pip install --no-cache-dir -r requirements-vercel.txt

# The QR image model runs on CPU in Vercel. Installing the default PyPI build
# pulls CUDA runtime packages that are not available or useful in this container.
RUN pip install --no-cache-dir torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu

COPY . .

EXPOSE 8000
CMD ["uvicorn", "backend.gateway:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
